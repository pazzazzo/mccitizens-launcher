{
  "name": "mccitizens-launcher",
  "version": "0.0.18",
  "description": "A launcher for MCCitizens",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron . --trace-warnings",
    "clearstore": "node clearStore.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "author": {
    "name": "Hydix",
    "url": "https://hydix.fr",
    "email": "contact@hydix.fr"
  },
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.5.15",
    "axios": "^1.7.5",
    "colors": "^1.4.0",
    "dotenv": "^17.2.1",
    "electron-log": "^5.4.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.2.1",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "nbtify": "^2.2.0",
    "net": "^1.0.2",
    "portfinder": "^1.0.37",
    "request": "^2.88.2",
    "skinview3d": "^3.0.0-alpha.1",
    "tar": "^7.4.3",
    "toml": "^3.0.0",
    "unzipper": "^0.12.3"
  },
  "build": {
    "appId": "fr.hydix.mccitizens-launcher",
    "productName": "MCCitizens_Launcher",
    "artifactName": "MCCitizens-Launcher-Setup-${version}.${ext}",
    "icon": "./src/assets/icons/minecraft.png",
    "directories": {
      "output": "dist"
    },
    "protocols": {
      "name": "Open Launcher",
      "schemes": [
        "electron-fiddle"
      ]
    },
    "files": [
      "src/**/*",
      ".env.prod",
      "workers/*",
      "node_modules/**/*",
      "package.json",
      "*.js",
      "!**/*.md",
      "!*.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "pazzazzo",
        "repo": "mccitizens-launcher"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "appimage"
      ],
      "category": "System",
      "desktop": {
        "MimeType": "x-scheme-handler/electron-fiddle;"
      }
    },
    "msi": {
      "oneClick": false
    }
  },
  "devDependencies": {
    "@eslint/css": "^0.10.0",
    "@eslint/js": "^9.32.0",
    "@eslint/json": "^0.13.1",
    "electron": "^36.1.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.32.0",
    "eslint-config-xo": "^0.48.0",
    "globals": "^16.3.0",
    "live-server": "^1.2.2"
  }
}
